# ─── Prenotazioni via Google Calendar ───────────────────────────────
# Service account Google Cloud con accesso ai due calendari.
GOOGLE_CLIENT_EMAIL="nome-service-account@progetto.iam.gserviceaccount.com"
# La private key dal file JSON. Su Vercel incollala con i \n letterali,
# oppure racchiusa tra virgolette con newline reali.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ID dei calendari (Impostazioni calendario → "Integra il calendario" → ID calendario)
GOOGLE_CALENDAR_AVAILABILITY_ID="xxxxxxxx@group.calendar.google.com"
GOOGLE_CALENDAR_APPOINTMENTS_ID="yyyyyyyy@group.calendar.google.com"

# Opzionale, default Europe/Rome
BOOKING_TIMEZONE="Europe/Rome"

# ─── Supabase (non ancora utilizzato) ───────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
